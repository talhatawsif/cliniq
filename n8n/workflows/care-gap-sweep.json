{
  "id": "cliniq-care-gap-sweep",
  "name": "ClinIQ weekly care-gap sweep",
  "nodes": [
    {
      "id": "b1",
      "name": "Every Monday 7:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 7
            }
          ]
        }
      }
    },
    {
      "id": "b2",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 400],
      "parameters": {}
    },
    {
      "id": "b3",
      "name": "Sweep care gaps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 300],
      "parameters": {
        "method": "POST",
        "url": "https://cliniq-inky-ten.vercel.app/api/care-gaps/sweep",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cliniq-integration-key",
          "name": "ClinIQ integration key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "id": "b4",
      "name": "Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [520, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "summary",
              "type": "string",
              "value": "={{ 'Care-gap sweep: ' + $json.created + ' Task(s) created, ' + $json.existing + ' already existed, ' + $json.gaps + ' open gap(s) across ' + $json.patients + ' patients' }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every Monday 7:00": {
      "main": [
        [
          {
            "node": "Sweep care gaps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Sweep care gaps",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sweep care gaps": {
      "main": [
        [
          {
            "node": "Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Australia/Sydney",
    "errorWorkflow": "cliniq-error-notice"
  },
  "active": false,
  "pinData": {}
}
