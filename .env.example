# Copy to .env.local and fill in. Never commit real values. See SPEC.md section 5.

# ClinIQ's own HAPI FHIR R4 server (demo mode)
FHIR_BASE_URL=https://cliniq-fhir-702838448237.us-central1.run.app/fhir

# SMART on FHIR (public sandbox accepts any client id)
SMART_CLIENT_ID=cliniq
SMART_REDIRECT_URI=http://localhost:3000/smart/callback

# Supabase (app data only: auth, audit log, pipeline runs, review decisions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Note extraction engine: rules (default, free) | precomputed | llm (optional, bring your own key)
EXTRACTION_ENGINE=rules
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# FHIR terminology server (NCTS Ontoserver, OAuth client credentials)
TERMINOLOGY_BASE_URL=
TERMINOLOGY_CLIENT_ID=
TERMINOLOGY_CLIENT_SECRET=

# Optional alternative terminology source
UMLS_API_KEY=
