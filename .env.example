# Copy to .env.local and fill in. Never commit real values.
FHIR_BASE_URL=http://localhost:8080/fhir

# Supabase (project "cliniq")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# NLP / extraction
EXTRACTION_ENGINE=rules
NLP_SERVICE_URL=

# LLM (free only). Every OpenRouter model id MUST end in ":free" (enforced in code).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Terminology (NCTS Ontoserver; UMLS as fallback)
TERMINOLOGY_BASE_URL=
TERMINOLOGY_CLIENT_ID=
TERMINOLOGY_CLIENT_SECRET=
UMLS_API_KEY=

# SMART on FHIR
SMART_CLIENT_ID=
SMART_REDIRECT_URI=

# n8n (optional, demo-time on the Mac)
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
