# Copy to .env.local and fill in. Never commit real values. Names match SPEC.md §6.
FHIR_BASE_URL=http://localhost:8080/fhir
# none = local Docker HAPI; gcp-iam = private Cloud Run (needs GCP_SA_KEY)
FHIR_AUTH=none
GCP_SA_KEY=

# Supabase (project "cliniq", Sydney)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# n8n -> app API (M14)
INTEGRATION_API_KEY=

# NLP service (unset = precomputed results for the sample notes)
NLP_SERVICE_URL=

# Terminology (unset = offline subset; credentials only for NCTS)
TERMINOLOGY_BASE_URL=
TERMINOLOGY_CLIENT_ID=
TERMINOLOGY_CLIENT_SECRET=

# LLM (assistant only). Every model id MUST end in ":free" (enforced in code).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=cohere/north-mini-code:free,baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3-ultra-550b-a55b:free

# SMART on FHIR (M12)
SMART_CLIENT_ID=
SMART_REDIRECT_URI=
SESSION_SECRET=
